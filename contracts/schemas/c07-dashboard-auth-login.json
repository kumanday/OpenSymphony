{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://entrevisata.ai/contracts/c07-dashboard-auth-login",
  "title": "C-07: Dashboard \u2192 Auth Lambda (Login)",
  "description": "Operator authentication and JWT token issuance",
  "metadata": {
    "contractId": "C-07",
    "from": "SVC-07 (dashboard)",
    "to": "SVC-06 (auth-lambda)",
    "method": "POST",
    "path": "/api/v1/auth/login",
    "auth": "None (public endpoint \u2014 brute-force protected)",
    "timeout": "10s",
    "pattern": "Synchronous Request-Response"
  },
  "request": {
    "headers": {
      "X-Correlation-ID": {
        "type": "string",
        "format": "uuid",
        "required": true,
        "description": "Unique request trace ID generated by the dashboard"
      },
      "Content-Type": {
        "type": "string",
        "enum": [
          "application/json"
        ],
        "required": true
      }
    },
    "body": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Operator email address"
        },
        "password": {
          "type": "string",
          "minLength": 8,
          "description": "Operator password"
        }
      }
    }
  },
  "response": {
    "200": {
      "body": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token (RS256)"
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque refresh token"
          },
          "expires_in": {
            "type": "integer",
            "enum": [
              3600
            ],
            "description": "Token TTL in seconds (60 minutes)"
          }
        }
      }
    },
    "401": {
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Invalid credentials"
      }
    },
    "429": {
      "error": {
        "code": "RATE_LIMITED",
        "message": "Account locked (brute-force protection)"
      }
    },
    "503": {
      "error": {
        "code": "SERVICE_UNAVAILABLE",
        "message": "JWT signing failed (Secrets Manager unreachable)"
      }
    }
  },
  "error_handling": {
    "brute_force": "5 failures = 15-minute lockout",
    "argon2_timing": "Hash comparison always runs to completion (no early exit on mismatch \u2014 prevents timing attacks)",
    "jwt_signing_failure": "Return 503; never issue unsigned tokens"
  }
}
