{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://entrevisata.ai/contracts/c02-conversation-to-evaluation",
  "title": "C-02: Conversation Lambda \u2192 Evaluation Lambda",
  "description": "Asynchronous evaluation request after screening completion",
  "metadata": {
    "contractId": "C-02",
    "from": "SVC-02 (conversation-lambda)",
    "to": "SVC-03 (evaluation-lambda)",
    "method": "POST",
    "path": "/api/v1/evaluate",
    "auth": "X-Internal-Secret",
    "timeout": "300s",
    "pattern": "Asynchronous (caller does not wait)"
  },
  "request": {
    "headers": {
      "X-Internal-Secret": {
        "type": "string",
        "required": true
      },
      "X-Correlation-ID": {
        "type": "string",
        "format": "uuid",
        "required": true
      },
      "Content-Type": {
        "type": "string",
        "enum": [
          "application/json"
        ],
        "required": true
      }
    },
    "body": {
      "type": "object",
      "required": [
        "session_id",
        "campaign_id",
        "tenant_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "campaign_id": {
          "type": "string",
          "description": "Campaign being evaluated"
        },
        "tenant_id": {
          "type": "string",
          "description": "Tenant scope identifier"
        }
      }
    }
  },
  "response": {
    "202": {
      "body": {
        "type": "object",
        "required": [
          "evaluation_id",
          "status"
        ],
        "properties": {
          "evaluation_id": {
            "type": "string",
            "description": "Unique evaluation job identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "EVALUATION_STARTED"
            ],
            "description": "Evaluation job status"
          }
        }
      }
    },
    "401": {
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Invalid X-Internal-Secret"
      }
    },
    "503": {
      "error": {
        "code": "SERVICE_UNAVAILABLE",
        "message": "Claude API or MongoDB unreachable"
      }
    }
  },
  "error_handling": {
    "missing_citation": "Reject score, retry Claude call once; on second failure, flag for manual review",
    "claude_api_failure": "Mark evaluation EVALUATION_FAILED; notify recruiter via dashboard"
  }
}