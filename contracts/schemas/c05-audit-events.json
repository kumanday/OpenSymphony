{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://entrevisata.ai/contracts/c05-audit-events",
  "title": "C-05: Any Service \u2192 Compliance Lambda (Audit Events)",
  "description": "Immutable audit log recording for all system events",
  "metadata": {
    "contractId": "C-05",
    "from": "Any service (SVC-02, SVC-03, SVC-04, SVC-05)",
    "to": "SVC-05 (compliance-lambda)",
    "method": "POST",
    "path": "/api/v1/audit/events",
    "auth": "X-Internal-Secret",
    "timeout": "5s",
    "pattern": "Synchronous (fire-and-verify)"
  },
  "request": {
    "headers": {
      "X-Internal-Secret": {
        "type": "string",
        "required": true
      },
      "X-Correlation-ID": {
        "type": "string",
        "format": "uuid",
        "required": true
      },
      "Content-Type": {
        "type": "string",
        "enum": [
          "application/json"
        ],
        "required": true
      }
    },
    "body": {
      "type": "object",
      "required": [
        "event_type",
        "actor",
        "tenant_id",
        "payload",
        "timestamp"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "MESSAGE_SENT",
            "MESSAGE_RECEIVED",
            "CONSENT_RECORDED",
            "SCORE_COMPUTED",
            "HUMAN_DECISION",
            "ESCALATION_TRIGGERED",
            "JAILBREAK_ATTEMPT",
            "DATA_PURGED"
          ],
          "description": "Type of audit event"
        },
        "actor": {
          "type": "string",
          "description": "Service or user that triggered the event"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Session context (nullable)"
        },
        "campaign_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Campaign context (nullable)"
        },
        "tenant_id": {
          "type": "string",
          "description": "Tenant scope identifier"
        },
        "payload": {
          "type": "object",
          "description": "Event-specific metadata"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 event timestamp"
        }
      }
    }
  },
  "response": {
    "201": {
      "body": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "description": "Unique audit event identifier"
          }
        }
      }
    },
    "401": {
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Invalid X-Internal-Secret"
      }
    },
    "500": {
      "error": {
        "code": "INTERNAL_ERROR",
        "message": "Audit write failure"
      }
    }
  },
  "error_handling": {
    "write_failure": "Log to CloudWatch with full event payload; never silently drop audit events",
    "retention_sweep_errors": "Log per-session errors; continue sweep (partial success acceptable)"
  }
}