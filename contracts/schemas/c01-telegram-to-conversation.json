{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://entrevisata.ai/contracts/c01-telegram-to-conversation",
  "title": "C-01: Telegram Bot → Conversation Lambda",
  "description": "Incoming message from Telegram gateway to conversation engine",
  "metadata": {
    "contractId": "C-01",
    "from": "SVC-01 (telegram-bot)",
    "to": "SVC-02 (conversation-lambda)",
    "method": "POST",
    "path": "/api/v1/messages",
    "auth": "X-Internal-Secret",
    "timeout": "28s",
    "pattern": "Synchronous Request-Response"
  },
  "request": {
    "headers": {
      "X-Internal-Secret": {
        "type": "string",
        "required": true,
        "description": "Shared secret from AWS Secrets Manager"
      },
      "X-Correlation-ID": {
        "type": "string",
        "format": "uuid",
        "required": true,
        "description": "Unique request trace ID"
      },
      "Content-Type": {
        "type": "string",
        "enum": ["application/json"],
        "required": true
      }
    },
    "body": {
      "type": "object",
      "required": ["telegram_user_id", "message_text", "message_id", "timestamp"],
      "properties": {
        "telegram_user_id": {
          "type": "string",
          "description": "Hashed Telegram user identifier"
        },
        "message_text": {
          "type": "string",
          "description": "User message content"
        },
        "campaign_code": {
          "type": ["string", "null"],
          "description": "Optional campaign deep-link code"
        },
        "message_id": {
          "type": "integer",
          "description": "Telegram message identifier"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of message receipt"
        }
      }
    }
  },
  "response": {
    "200": {
      "body": {
        "type": "object",
        "required": ["text", "session_state", "show_nps_keyboard"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Reply text to send to candidate via Telegram"
          },
          "session_state": {
            "type": "string",
            "enum": [
              "AWAITING_CONSENT",
              "REQUIREMENTS_CHECK",
              "SCREENING",
              "COMPLETED",
              "ESCALATED",
              "ABANDONED"
            ],
            "description": "Current state of the conversation state machine"
          },
          "show_nps_keyboard": {
            "type": "boolean",
            "description": "Whether to display NPS rating keyboard to candidate"
          }
        }
      }
    },
    "400": {
      "description": "Invalid request payload",
      "error": {
        "code": "VALIDATION_ERROR",
        "message": "string",
        "details": {}
      }
    },
    "401": {
      "description": "Invalid shared secret",
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Invalid X-Internal-Secret"
      }
    },
    "503": {
      "description": "MongoDB or Claude unreachable",
      "error": {
        "code": "SERVICE_UNAVAILABLE",
        "message": "string"
      }
    }
  },
  "error_handling": {
    "5xx_to_telegram": "Return scripted 'technical issue' message to candidate; log to CloudWatch",
    "timeout_to_telegram": "Return scripted 'processing' message to candidate",
    "always_return_200_to_telegram": true,
    "reason": "Prevent Telegram webhook retry storms"
  }
}
