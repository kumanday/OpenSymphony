{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://entrevisata.ai/contracts/c06-escalations",
  "title": "C-06: Conversation Lambda \u2192 Compliance Lambda (Escalation Alerts)",
  "description": "Escalation alert creation for human intervention",
  "metadata": {
    "contractId": "C-06",
    "from": "SVC-02 (conversation-lambda)",
    "to": "SVC-05 (compliance-lambda)",
    "method": "POST",
    "path": "/api/v1/escalations",
    "auth": "X-Internal-Secret",
    "timeout": "5s",
    "pattern": "Synchronous (fire-and-verify)"
  },
  "request": {
    "headers": {
      "X-Internal-Secret": {
        "type": "string",
        "required": true
      },
      "X-Correlation-ID": {
        "type": "string",
        "format": "uuid",
        "required": true
      },
      "Content-Type": {
        "type": "string",
        "enum": [
          "application/json"
        ],
        "required": true
      }
    },
    "body": {
      "type": "object",
      "required": [
        "session_id",
        "candidate_alias",
        "campaign_id",
        "tenant_id",
        "escalation_type",
        "context",
        "timestamp"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "candidate_alias": {
          "type": "string",
          "description": "Candidate anonymized alias"
        },
        "campaign_id": {
          "type": "string",
          "description": "Campaign scope"
        },
        "tenant_id": {
          "type": "string",
          "description": "Tenant scope identifier"
        },
        "escalation_type": {
          "type": "string",
          "enum": [
            "HUMAN_REQUESTED",
            "GUARDRAIL_THRESHOLD"
          ],
          "description": "Type of escalation trigger"
        },
        "context": {
          "type": "string",
          "description": "Escalation context and reasoning"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 escalation timestamp"
        }
      }
    }
  },
  "response": {
    "201": {
      "body": {
        "type": "object",
        "required": [
          "alert_id"
        ],
        "properties": {
          "alert_id": {
            "type": "string",
            "description": "Unique escalation alert identifier"
          }
        }
      }
    },
    "401": {
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Invalid X-Internal-Secret"
      }
    },
    "500": {
      "error": {
        "code": "INTERNAL_ERROR",
        "message": "Escalation creation failure"
      }
    }
  },
  "error_handling": {
    "creation_failure": "Log to CloudWatch; retry once; if still failing, session continues without escalation"
  }
}